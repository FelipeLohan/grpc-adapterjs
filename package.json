{
  "name": "express-grpc",
  "version": "0.1.0",
  "description": "Express DX for native gRPC over node:http2 — no @grpc/grpc-js, no C++ bindings",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "example:proto:js": "pbjs -t static-module -w commonjs -o test/fixtures/helloworld.pb.js test/fixtures/helloworld.proto",
    "example:proto:dts": "pbts -o test/fixtures/helloworld.pb.d.ts test/fixtures/helloworld.pb.js"
  },
  "engines": {
    "node": ">= 20"
  },
  "dependencies": {
    "protobufjs": "^7.4.0"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "protobufjs-cli": "^2.6.2"
  },
  "license": "MIT"
}
